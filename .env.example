# Template para configuración
# Copiar a .env y reemplazar valores

# ============ SQL SERVER ============
DB_SERVER=localhost
DB_DATABASE=database_name
DB_ENCRYPTION=true
DB_TRUST_CERTIFICATE=false

# Windows Auth - dejar vacío usuario y password
# SQL Auth - completar usuario y password
DB_USERNAME=
DB_PASSWORD=

# ============ EMAIL ============
EMAIL_USER=ejemplo@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_RECIPIENT=destino@gmail.com
EMAIL_RECIPIENT_BACKUP=

# ============ APLICACIÓN ============
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============ SCHEDULES ============
# Zona horaria para los cron jobs (opcional)
TZ_SCHEDULES=America/Lima

# ============ RUTAS ============
EXCEL_OUTPUT_PATH=./xlsx_output
LOG_PATH=./logs
