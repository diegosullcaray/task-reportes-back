# Template para configuración
# Copiar a .env y reemplazar valores

# ============ SQL SERVER ============
# Mismos datos que la ventana "Connect to Server" de SSMS
DB_SERVER=nombre-o-ip-del-servidor
DB_DATABASE=nombre-base-datos

# Windows Authentication (igual que SSMS con DOMINIO\usuario):
# dejar DB_DOMAIN vacío/sin definir para usar SQL Server Authentication en vez de NTLM
DB_DOMAIN=DOMINIO
DB_USERNAME=usuario
DB_PASSWORD=contraseña

# Si la instancia tiene nombre (ej. SERVIDOR\SQLEXPRESS) usar DB_INSTANCE;
# si no, se conecta al puerto DB_PORT (default 1433)
#DB_INSTANCE=
#DB_PORT=1433

DB_ENCRYPTION=false
DB_TRUST_CERTIFICATE=true

# ============ EMAIL (Google Workspace) ============
# Contraseña de aplicación de Google: pegar los 16 caracteres JUNTOS,
# sin espacios ni guiones (Google la muestra como "abcd efgh ijkl mnop")
EMAIL_USER=usuario@confianza.pe
EMAIL_PASSWORD=abcdefghijklmnop

# Servidor SMTP (opcional). Si el firewall bloquea el 465, usar EMAIL_PORT=587
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=465

# Firma de los correos (opcional; si se omite usa el valor por defecto de shared/utils/email-template.js)
EMAIL_FIRMA_NOMBRE=Nombre Apellido
EMAIL_FIRMA_CARGO=Cargo

# ============ DESTINATARIOS (opcional, sobreescriben los por defecto) ============
# Listas separadas por comas
#CARTERA_HEREDADA_PARA=abigail.jaimes@confianza.pe,karla.campos@confianza.pe,ricardo.lazo@confianza.pe,alvaro.calderon@confianza.pe
#CARTERA_HEREDADA_CC=michael.palacios@confianza.pe
#DESEMBOLSO_CANAL_PARA=sergio.sandoval@confianza.pe,sebastien.puertas@confianza.pe
#DESEMBOLSO_CANAL_CC=abigail.jaimes@confianza.pe,michael.palacios@confianza.pe
#FONDEO_ESTABLE_PARA=eddy.martinez@confianza.pe
#FONDEO_ESTABLE_CC=michael.palacios@confianza.pe,abigail.jaimes@confianza.pe
#RATIO_CE_PARA=correo1@confianza.pe,correo2@confianza.pe
#RATIO_CE_CC=michael.palacios@confianza.pe

# ============ APLICACIÓN ============
NODE_ENV=development
PORT=3000
# HOST 0.0.0.0 = accesible desde la red por la IP de esta máquina
HOST=0.0.0.0
LOG_LEVEL=info

# ============ SCHEDULES ============
# Zona horaria para los cron jobs
TZ_SCHEDULES=America/Lima

# ============ RUTAS ============
EXCEL_OUTPUT_PATH=./xlsx_output
LOG_PATH=./logs

# ============ SEGURIDAD ============
# Orígenes permitidos por CORS, separados por comas (ej. https://intranet.confianza.pe).
# Si se omite, CORS queda abierto (no hay login/cookies que proteger).
#CORS_ORIGIN=

# ============ NOTIFICACIONES ============
# Webhook entrante de un espacio de Google Chat (gratis con Workspace):
# en el espacio → nombre del espacio → "Apps e integraciones" → "Webhooks" → crear → copiar URL.
# Si se omite, el control de cargas sigue funcionando pero no notifica a Chat (solo loguea un warning).
#GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAAA/messages?key=xxx&token=yyy
